# Copy to .env for local testing. NEVER commit .env or real secrets.
# In production, set these in your hosting provider's secret/env settings.

PORT=3000

# REQUIRED in production: 32-byte HMAC secret shown ONCE at agent registration.
# Store it securely. Never commit it. Rotate it from agent settings if leaked.
AGENT_GAMES_HMAC_SECRET=

# Local testing ONLY. Never "true" in production.
ALLOW_UNVERIFIED=false

# Proof generation (see README "Bukti Groth16").
PROOF_ENABLED=true
# CIRCUIT_WASM_PATH=./circuits/gatekeeper.wasm
# CIRCUIT_ZKEY_PATH=./circuits/gatekeeper_final.zkey
# CIRCUIT_INPUTS_FILE=./circuits/inputs.json

# Kurier (optional, recommended path). Get API key + URL from Kurier docs/dashboard.
# Do not guess the URL.
KURIER_ENABLED=false
KURIER_API_KEY=
KURIER_API_URL=
